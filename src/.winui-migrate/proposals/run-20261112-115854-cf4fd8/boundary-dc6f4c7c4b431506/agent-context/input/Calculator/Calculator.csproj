<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>CalculatorApp</RootNamespace>
    <AssemblyName>CalculatorApp</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <LangVersion>9.0</LangVersion>
    <NoWarn>;2008</NoWarn>
    <OutputType>WinExe</OutputType>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="Package.Release.appxmanifest" Condition="'$(UseReleaseAppxManifest)' == 'True'" />
    <AppxManifest Include="Package.appxmanifest" Condition="'$(UseReleaseAppxManifest)' != 'True'" />
  </ItemGroup>

